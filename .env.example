# GEMINI_API_KEY: Optional server-side Gemini API key for AI-assisted listing suggestions.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the deployed application.
APP_URL="http://localhost:3000"

# Supabase Configuration (Client & Server)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Server-Only Supabase Service Role Key (NEVER expose in frontend or NEXT_PUBLIC_ / VITE_ vars)
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Server-Side Session Signing Secret (used by Express backend)
SESSION_SECRET=
